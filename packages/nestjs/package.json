{
    "name": "@hfu.digital/boardkit-nestjs",
    "version": "2026.04.15",
    "description": "NestJS module for BoardKit — real-time collaboration server with pluggable storage adapters",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "https://github.com/hfu-digital/BoardKit.git",
        "directory": "packages/nestjs"
    },
    "keywords": ["whiteboard", "nestjs", "collaboration", "real-time", "socket.io", "boardkit"],
    "sideEffects": false,
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js",
            "default": "./dist/index.js"
        }
    },
    "files": ["dist"],
    "engines": {
        "node": ">=18.0.0"
    },
    "scripts": {
        "build": "tsc",
        "dev": "tsc --watch",
        "clean": "rm -rf dist",
        "lint": "eslint src/",
        "test": "vitest run",
        "test:watch": "vitest",
        "prepublishOnly": "npm run build"
    },
    "dependencies": {
        "@hfu.digital/boardkit-core": "workspace:*"
    },
    "peerDependencies": {
        "@nestjs/common": "^10.0.0 || ^11.0.0",
        "@nestjs/core": "^10.0.0 || ^11.0.0",
        "@nestjs/websockets": "^10.0.0 || ^11.0.0",
        "@nestjs/platform-socket.io": "^10.0.0 || ^11.0.0",
        "rxjs": "^7.0.0"
    },
    "publishConfig": {
        "access": "public",
        "registry": "https://registry.npmjs.org/"
    },
    "devDependencies": {
        "@nestjs/common": "^10.0.0",
        "@nestjs/core": "^10.0.0",
        "@nestjs/websockets": "^10.0.0",
        "@nestjs/platform-socket.io": "^10.0.0",
        "rxjs": "^7.0.0",
        "typescript": "^5.0.0",
        "vitest": "^3.0.0"
    }
}
