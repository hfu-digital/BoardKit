{
    "name": "@hfu.digital/boardkit-react",
    "version": "2026.04.15",
    "description": "React component library for BoardKit — dual-canvas renderer, hooks, and real-time collaboration UI",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "https://github.com/hfu-digital/BoardKit.git",
        "directory": "packages/react"
    },
    "keywords": ["whiteboard", "react", "canvas", "collaboration", "real-time", "boardkit"],
    "sideEffects": ["**/*.css", "**/styles/fonts.ts", "**/styles/fonts.js"],
    "main": "dist/index.js",
    "module": "dist/index.es.js",
    "types": "dist/index.d.ts",
    "style": "dist/boardkit.css",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.es.js",
            "require": "./dist/index.js",
            "default": "./dist/index.js"
        },
        "./styles.css": "./dist/boardkit.css"
    },
    "files": ["dist"],
    "engines": {
        "node": ">=18.0.0"
    },
    "scripts": {
        "build": "vite build",
        "dev": "vite build --watch",
        "clean": "rm -rf dist",
        "lint": "eslint src/",
        "test": "vitest run",
        "test:watch": "vitest",
        "prepublishOnly": "npm run build"
    },
    "dependencies": {
        "@hfu.digital/boardkit-core": "workspace:*",
        "roughjs": "^4.6.6"
    },
    "peerDependencies": {
        "react": "^18.0.0 || ^19.0.0",
        "react-dom": "^18.0.0 || ^19.0.0",
        "socket.io-client": "^4.0.0",
        "lucide-react": ">=0.400.0"
    },
    "publishConfig": {
        "access": "public",
        "registry": "https://registry.npmjs.org/"
    },
    "devDependencies": {
        "react": "^18.0.0",
        "react-dom": "^18.0.0",
        "@types/react": "^18.0.0",
        "@types/react-dom": "^18.0.0",
        "vite": "^5.0.0",
        "@vitejs/plugin-react": "^4.0.0",
        "vite-plugin-dts": "^3.0.0",
        "typescript": "^5.0.0",
        "socket.io-client": "^4.0.0",
        "vitest": "^3.0.0",
        "lucide-react": ">=0.400.0",
        "roughjs": "^4.6.6"
    }
}
